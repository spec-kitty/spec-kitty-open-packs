# @spec-kitty/doc-toolkit is published to GitHub Packages, not the public npm
# registry. This maps the scope only; it carries no secret. Put the token
# (classic PAT with read:packages) in your user-level ~/.npmrc:
#   //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# pnpm ignores env-var credentials in a project .npmrc.
@spec-kitty:registry=https://npm.pkg.github.com
