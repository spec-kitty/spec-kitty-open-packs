{"aggregate_id": "01M7YGMQ1JGV7BJ0CNBBM9J0AX", "aggregate_type": "Mission", "event_id": "01M7YGMQR2XHH5H5VKYHVA4HKT", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-21T07:37:57.717859+00:00", "friendly_name": "Citation and docs writing doctrine", "mission_id": "01M7YGMQ1JGV7BJ0CNBBM9J0AX", "mission_number": null, "mission_slug": "citation-and-docs-writing-01M7YGMQ", "mission_type": "software-dev", "purpose_context": "Durable artifacts keep citing bare commit SHAs and line ranges that the mission lifecycle's own rebases and compaction leave dangling, squad briefs declare blockers resolved without reproducing them, the anti-AI-prose rules reach only internal reports, and the common-docs styleguide still teaches the path-string audience and related shapes that doc-kitty rejects. This mission states the stable-identifier and content-anchored citation rules once in the writing pack's citation styleguide, adds reproduce-before-resolved and reachability-before-ruling steps to the squad procedure, ships a shared AI-writing-tells styleguide that internal report writing references, and rewrites the common-docs guidance around doc-kitty's frontmatter with neutral examples.", "purpose_tldr": "Give writers one citable rule for citations that survive history rewrites, one shared list of AI-prose tells, and doc-kitty frontmatter as the docs default.", "target_branch": "feat/citation-and-docs-writing", "wp_count": 0}, "project_slug": "spec-kitty-open-packs", "project_uuid": "6578ac86-9932-464f-85e3-472f38c9990d", "schema_version": "5.0.0", "timestamp": "2026-11-21T07:37:57.762255+00:00"}
