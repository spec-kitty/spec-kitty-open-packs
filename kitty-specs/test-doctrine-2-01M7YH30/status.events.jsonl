{"aggregate_id": "01M7YH303GM7171YZQZK7NZZ96", "aggregate_type": "Mission", "event_id": "01M7YH310Z4TYGT5AM12M4TR01", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-21T07:45:45.937924+00:00", "friendly_name": "Test doctrine 2: tests-as-scaffold paradigm, tracer bullets and measurement discipline", "mission_id": "01M7YH303GM7171YZQZK7NZZ96", "mission_number": null, "mission_slug": "test-doctrine-2-01M7YH30", "mission_type": "software-dev", "purpose_context": "The first test-doctrine mission shipped the mock-boundary rule. This one finishes that work: the tests-as-scaffold mindset moves out of a binding directive into its own paradigm, the two mocking anti-patterns become named graph nodes, duplicated checklists and long worked examples move into shared reference assets, and the curator profile learns the canonical layout. It also sharpens test-first guidance with vertical tracer-bullet slicing (one behaviour, one failing test, one minimal change), ships a vertical-skeleton-first planning tactic for missions whose work crosses owners, separates refactoring from the red-green loop as a green-mode technique, and adds a measurement discipline so agents sharing a machine do not read killed or contended test runs as results.", "purpose_tldr": "Give the test doctrine its missing mindset, reference examples and checklists, and teach vertical tracer-bullet slicing and honest test measurement.", "target_branch": "t3/test-doctrine-2", "wp_count": 0}, "project_slug": "spec-kitty-open-packs", "project_uuid": "6578ac86-9932-464f-85e3-472f38c9990d", "schema_version": "5.0.0", "timestamp": "2026-11-21T07:45:46.015339+00:00"}
